# Copy to .env.local for local development. Never commit real keys.

# Optional: enables live AI explanations on the "Ask the analyst" page.
# Without it the app runs in clearly labelled demo mode.
ANTHROPIC_API_KEY=

# Optional: model name for the explanation layer (default: claude-sonnet-5-5).
ANTHROPIC_MODEL=

# Optional: request timeout for the AI provider, in milliseconds (default 45000).
LLM_TIMEOUT_MS=

# Optional: n8n webhook that receives human-approved actions.
N8N_WEBHOOK_URL=

# Optional: shared secret sent as the x-webhook-secret header to n8n.
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Company deployment (self-hosted / Docker). See docs/DEPLOYMENT.md.
# ---------------------------------------------------------------------------

# Folder where company datasets, settings and the drop folder are stored.
# Defaults to ./.data when self-hosted. Not used on Vercel unless set
# (Vercel has no persistent disk; data then stays in each user's browser).
DATA_DIR=

# Secret that pipelines send as "Authorization: Bearer <token>" to /api/ingest.
# Use a long random value, e.g.: openssl rand -hex 32
INGEST_TOKEN=

# Set to false to hide the fictional sample company completely.
ENABLE_SAMPLE_DATA=true

# Set both to require a sign-in (HTTP Basic) for every page and API except
# /api/ingest (which uses INGEST_TOKEN). Use HTTPS. Prefer company SSO in front
# of the app for larger rollouts.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Set to false to stop CSV uploads from the browser (pipeline-only deployments).
ALLOW_UI_UPLOADS=true
